# Dogmarked environment variables (names only — never commit real values)
# Copy to .env.local for local development.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler (Cloud → API keys) — tiles + interactive geocoding
NEXT_PUBLIC_MAPTILER_KEY=

# Public app URL (local / preview / production)
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
