# Dogmarked environment variables (names only — never commit real values)
# Copy to .env.local for local development.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler (Cloud → API keys) — tiles + interactive geocoding / PlaceProvider
NEXT_PUBLIC_MAPTILER_KEY=

# Foursquare Places API (server-only — never expose to the browser)
FOURSQUARE_API_KEY=

# Discovery vs enrichment controls (private MVP defaults)
FSQ_DISCOVERY_ENABLED=true
FSQ_ENRICHMENT_ENABLED=true
FSQ_PHOTOS_ENABLED=true
# Tips are paid enrichment — off by default
FSQ_TIPS_ENABLED=false
FSQ_MONTHLY_DISCOVERY_CALL_LIMIT=1000
FSQ_MONTHLY_ENRICHMENT_BUDGET_USD=25
# Rough USD estimates per enrichment call — verify against Foursquare dashboard
# FSQ_COST_DETAILS_USD=0.05
# FSQ_COST_PHOTOS_USD=0.05
# FSQ_COST_TIPS_USD=0.05

# Booking / place links (Phase 11+) — verified non-affiliate links on; monetization off
# BOOKING_LINKS_ENABLED: show verified Booking.com property URLs (never search pages)
# BOOKING_AFFILIATE_ENABLED: partner / affiliate_links CTAs (future)
# BOOKING_DEMAND_API_ENABLED: Booking Demand API (future)
BOOKING_LINKS_ENABLED=true
BOOKING_AFFILIATE_ENABLED=false
BOOKING_DEMAND_API_ENABLED=false

# Public app URL (local / preview / production)
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
